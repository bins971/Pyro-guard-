# Database (SQLite for temporary testing)
DATABASE_URL=sqlite:///./pyroguard.db

# Model Configuration
MODEL_PATH=models/fire_yolov8.pt
CONFIDENCE_THRESHOLD=0.15
FIRE_LEVEL_THRESHOLDS=0.05,0.15

# Email Alert Configuration (Brevo)
# Get credentials from: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-email@smtp-brevo.com
SMTP_PASSWORD=your-api-key-here
SMTP_FROM=alerts@yourdomain.com
ALERT_RECIPIENTS=recipient1@email.com,recipient2@email.com

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Performance Settings
FRAME_SKIP=3
ALERT_COOLDOWN_SECONDS=300
MIN_CONFIDENCE_FOR_ALERT=0.7
